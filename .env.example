# Vevvion — environment variables
# Copy to .env.local and fill in values. NEVER commit .env.local.
# NEXT_PUBLIC_* values are sent to the browser — never put secrets in them.

# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_STORE_NAME=Vevvion

# ── MongoDB (DigitalOcean) ──────────────────────────
# Full connection string incl. database name, e.g.
# mongodb+srv://USER:PASS@HOST/vevvion?tls=true&authSource=admin&replicaSet=REPLICA_SET
MONGODB_URI=
# Optional: database name if not in the URI
MONGODB_DB_NAME=
# Optional: DigitalOcean CA certificate (PEM contents, newlines as \n) — needed for DO Managed MongoDB TLS
MONGODB_TLS_CA_CERT=

# ── Authentication (Better Auth) ────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# First owner account (used once by `pnpm create-owner`)
OWNER_SEED_NAME=
OWNER_SEED_EMAIL=
OWNER_SEED_PASSWORD=

# ── Razorpay ────────────────────────────────────────
# Use rzp_test_... keys until the full flow is tested
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Images ──────────────────────────────────────────
# Which provider to use: cloudinary | imagekit  (only one is implemented/used)
IMAGE_PROVIDER=cloudinary

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=vevvion
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ImageKit (alternative — fill only if IMAGE_PROVIDER=imagekit)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=

# ── Email (order notifications, password reset) ─────
# Provider: resend (recommended). Leave empty to disable emails.
RESEND_API_KEY=
EMAIL_FROM=

# ── Cron ────────────────────────────────────────────
# Protects /api/cron/* endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=
